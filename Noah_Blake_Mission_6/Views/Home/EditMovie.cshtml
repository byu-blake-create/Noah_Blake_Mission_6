@model Movie
@{
    ViewData["Title"] = "Edit Movie";
}

<h1>Edit Movie</h1>

<form asp-action="EditMovie" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="MovieId" type="hidden"/>
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
            <option value="">Select a category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control"/>
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Director" class="form-label"></label>
        <input asp-for="Director" class="form-control"/>
        <span asp-validation-for="Director" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Rating" class="form-label"></label>
        <select asp-for="Rating" class="form-select">
            <option value="">Select a rating</option>
            <option>G</option>
            <option>PG</option>
            <option>PG-13</option>
            <option>R</option>
        </select>
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Edited" class="form-label d-block"></label>
        <div class="form-check form-check-inline">
            <input asp-for="Edited" class="form-check-input" type="radio" value="true" id="EditEditedYes"/>
            <label class="form-check-label" for="EditEditedYes">Yes</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="Edited" class="form-check-input" type="radio" value="false" id="EditEditedNo"/>
            <label class="form-check-label" for="EditEditedNo">No</label>
        </div>
        <span asp-validation-for="Edited" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CopiedToPlex" class="form-label d-block"></label>
        <div class="form-check form-check-inline">
            <input asp-for="CopiedToPlex" class="form-check-input" type="radio" value="true" id="EditCopiedToPlexYes"/>
            <label class="form-check-label" for="EditCopiedToPlexYes">Yes</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="CopiedToPlex" class="form-check-input" type="radio" value="false" id="EditCopiedToPlexNo"/>
            <label class="form-check-label" for="EditCopiedToPlexNo">No</label>
        </div>
        <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LentTo" class="form-label"></label>
        <input asp-for="LentTo" class="form-control"/>
        <span asp-validation-for="LentTo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <input asp-for="Notes" class="form-control" maxlength="25"/>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="MovieList" class="btn btn-secondary ms-2">Cancel</a>
</form>
