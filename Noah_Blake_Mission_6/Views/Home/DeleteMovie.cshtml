@model Movie
@{
    ViewData["Title"] = "Delete Movie";
}

<h1 class="mb-3">Delete Movie</h1>

<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this movie?
</div>

<dl class="row">
    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Year</dt>
    <dd class="col-sm-9">@Model.Year</dd>

    <dt class="col-sm-3">Category</dt>
    <dd class="col-sm-9">@(Model.Category?.CategoryName ?? "-")</dd>

    <dt class="col-sm-3">Director</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Director) ? "-" : Model.Director)</dd>

    <dt class="col-sm-3">Rating</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Rating) ? "-" : Model.Rating)</dd>
</dl>

<form asp-action="DeleteMovieConfirmed" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="movieId" value="@Model.MovieId"/>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="MovieList" class="btn btn-secondary ms-2">Cancel</a>
</form>
